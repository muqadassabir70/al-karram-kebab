# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/alkarram_kebab?retryWrites=true&w=majority
MONGODB_URI=

# Optional Database Name (Defaults to alkarram_kebab)
MONGODB_DB_NAME=alkarram_kebab

# Owner Dashboard Login Password (Default: alkarram2026)
OWNER_PASSWORD=alkarram2026

# JWT / Session Signing Secret
JWT_SECRET=alkarram_super_secret_jwt_key_2026

# Port for local server (Default: 3000)
PORT=3000
